# DM3 Local Development Environment
# Used by docker-compose.local.yml — committed to repo (local dev only, no prod secrets)

# ── Database ─────────────────────────────────────────────────────────────────
DB_NAME=dm3
DB_USER=dm3
DB_PASSWORD=dm3secret

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=dm3-local-jwt-secret-change-me

# ── NATS / MQTT ──────────────────────────────────────────────────────────────
NATS_URL=nats://nats:4222
MQTT_BROKER=tcp://emqx:1883

# ── Object Store (MinIO) ────────────────────────────────────────────────────
OBJECT_STORE_ENDPOINT=minio:9000
OBJECT_STORE_ACCESS_KEY=dm3admin
OBJECT_STORE_SECRET_KEY=dm3secret123
OBJECT_STORE_BUCKET=dm3
OBJECT_STORE_USE_SSL=false

# ── Valkey (Redis-compatible) ────────────────────────────────────────────────
VALKEY_URL=valkey:6379

# ── Device Bootstrap ────────────────────────────────────────────────────────
BOOTSTRAP_SECRET=dm3-bootstrap-v1-dev-secret

# ── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=info@demasterpro.com
SMTP_PASSWORD=yedjmokxoxtshpqz
SMTP_FROM_NAME=DeMasterPro
SMTP_FROM_ADDR=info@demasterpro.com

# ── App ─────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
