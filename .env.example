# DM3 Production Environment Variables
# Copy to .env and fill in real values before deploying.
# This file is committed to the repo. .env is NOT committed (add to .gitignore).

# ── Database (TimescaleDB) ────────────────────────────────────────────────────
DB_NAME=dm3
DB_USER=dm3
DB_PASSWORD=CHANGE_ME_strong_password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_chars

# ── Device Provisioning ───────────────────────────────────────────────────────
# Used by device-gateway bootstrap flow
BOOTSTRAP_SECRET=CHANGE_ME_bootstrap_secret
# Comma-separated list of trusted Android app signing certificate SHA-256 hashes (optional)
KNOWN_APP_SIGNATURES=

# ── MinIO Object Storage ──────────────────────────────────────────────────────
MINIO_ROOT_USER=dm3admin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
OBJECT_STORE_ENDPOINT=minio:9000
OBJECT_STORE_ACCESS_KEY=${MINIO_ROOT_USER}
OBJECT_STORE_SECRET_KEY=${MINIO_ROOT_PASSWORD}
OBJECT_STORE_BUCKET=dm3
OBJECT_STORE_USE_SSL=false
OBJECT_STORE_AUTO_CREATE_BUCKET=true
# Host baked into presigned URLs. Devices (terminal media uploads) and
# browsers (event photos, clip playback) fetch these URLs directly, so the
# host must be publicly reachable — NOT the internal `minio:9000`. nginx
# proxies dm3-s3.* to minio:9000 (S3 API). Add an A-record and extend the
# certbot command in deploy/README.md with `-d dm3-s3.demasterpro.com`.
#
# The public hostname clients (Android terminals, browsers) will hit for
# MinIO GET/PUT. The backend bakes THIS value into the Host header when
# computing SigV4 signatures — if the client ends up hitting a different
# host, SigV4 mismatch → 403 SignatureDoesNotMatch.
#
# On fresh installs, `install.sh` substitutes __SERVER_IP__ with the detected
# server IP. Nginx also proxies /dm3/ to minio:9000 for IP-mode deploys, so
# this "just works" without DNS. For production, override with your real
# hostname once dm3-s3.<domain> points at the server and TLS is live.
OBJECT_STORE_PUBLIC_ENDPOINT=__SERVER_IP__
OBJECT_STORE_PUBLIC_USE_SSL=false

# ── Frontend runtime config ───────────────────────────────────────────────────
# Injected into /config.js — no rebuild required to change these
# On fresh installs, `install.sh` replaces __SERVER_IP__ with the detected
# primary IP. Override here with a real domain (https://) once DNS + TLS are
# configured — see INSTALL-GUIDE.md "SSL / TLS Setup".
API_URL=http://__SERVER_IP__
MQTT_WS_URL=ws://__SERVER_IP__/mqtt

# ── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=info@demasterpro.com
SMTP_PASSWORD=CHANGE_ME_smtp_password
SMTP_FROM_NAME=DeMasterPro
SMTP_FROM_ADDR=info@demasterpro.com
APP_URL=http://__SERVER_IP__

# ── CORS ──────────────────────────────────────────────────────────────────────
# Restrict in production to your frontend origin
CORS_ORIGIN=http://__SERVER_IP__

# ── WebSocket allowed origins (device-gateway /ws/events) ─────────────────────
# Comma-separated list. Browsers send an Origin header on WS upgrades and
# device-gateway rejects anything not in this list. On fresh installs,
# `install.sh` substitutes __SERVER_IP__ with the detected host IP.
# Devices / curl / non-browser clients are allowed regardless (no Origin hdr).
WS_ALLOWED_ORIGINS=http://__SERVER_IP__

# ── CCTV ──────────────────────────────────────────────────────────────────────
# 32 random bytes base64-encoded. Generate with: openssl rand -base64 32
# Never commit the real value. Rotate on suspected exposure.
CCTV_CREDENTIAL_KEY=<base64-encoded-32-random-bytes>

# ── MediaMTX ──────────────────────────────────────────────────────────────────
# Stream user: publish/read RTSP/WebRTC. Admin user: MediaMTX control API.
# Generate each password with: openssl rand -hex 24
MEDIAMTX_STREAM_USER=dm3stream
MEDIAMTX_STREAM_PASS=<random-hex>
MEDIAMTX_API_USER=dm3admin
MEDIAMTX_API_PASS=<random-hex>
# Advertised as ICE candidate so browsers can reach WebRTC from outside the
# Docker bridge. install.sh replaces __SERVER_IP__ with the detected host IP.
MEDIAMTX_PUBLIC_IP=__SERVER_IP__
