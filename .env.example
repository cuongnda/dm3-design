# DM3 Production Environment Variables
# Copy to .env and fill in real values before deploying.
# This file is committed to the repo. .env is NOT committed (add to .gitignore).

# ── Database (TimescaleDB) ────────────────────────────────────────────────────
DB_NAME=dm3
DB_USER=dm3
DB_PASSWORD=CHANGE_ME_strong_password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_jwt_secret_at_least_32_chars

# ── Device Provisioning ───────────────────────────────────────────────────────
# Used by device-gateway bootstrap flow
BOOTSTRAP_SECRET=CHANGE_ME_bootstrap_secret
# Comma-separated list of trusted Android app signing certificate SHA-256 hashes (optional)
KNOWN_APP_SIGNATURES=

# ── MinIO Object Storage ──────────────────────────────────────────────────────
MINIO_ROOT_USER=dm3admin
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
OBJECT_STORE_ENDPOINT=minio:9000
OBJECT_STORE_ACCESS_KEY=${MINIO_ROOT_USER}
OBJECT_STORE_SECRET_KEY=${MINIO_ROOT_PASSWORD}
OBJECT_STORE_BUCKET=dm3
OBJECT_STORE_USE_SSL=false
OBJECT_STORE_AUTO_CREATE_BUCKET=true

# ── Frontend runtime config ───────────────────────────────────────────────────
# Injected into /config.js — no rebuild required to change these
API_URL=https://dm3-api.demasterpro.com
MQTT_WS_URL=wss://dm3-mqtt.demasterpro.com/mqtt

# ── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=info@demasterpro.com
SMTP_PASSWORD=CHANGE_ME_smtp_password
SMTP_FROM_NAME=DeMasterPro
SMTP_FROM_ADDR=info@demasterpro.com
APP_URL=https://dm3.demasterpro.com

# ── CORS ──────────────────────────────────────────────────────────────────────
# Restrict in production to your frontend origin
CORS_ORIGIN=https://dm3.demasterpro.com

# ── CCTV ──────────────────────────────────────────────────────────────────────
# 32 random bytes base64-encoded. Generate with: openssl rand -base64 32
# Never commit the real value. Rotate on suspected exposure.
CCTV_CREDENTIAL_KEY=<base64-encoded-32-random-bytes>

# ── MediaMTX ──────────────────────────────────────────────────────────────────
# Stream user: publish/read RTSP/WebRTC. Admin user: MediaMTX control API.
# Generate each password with: openssl rand -hex 24
MEDIAMTX_STREAM_USER=dm3stream
MEDIAMTX_STREAM_PASS=<random-hex>
MEDIAMTX_API_USER=dm3admin
MEDIAMTX_API_PASS=<random-hex>
