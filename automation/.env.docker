# ══════════════════════════════════════════════════════════════════════════════
# DM3 Automation Container Configuration
# Mount this file via docker-compose env_file or copy to runner's home
# ══════════════════════════════════════════════════════════════════════════════

# ── Service URLs (internal Docker network names) ─────────────────────────────
API_BASE_URL=http://device-gateway:8002
WEB_BASE_URL=http://webapp:3000
HOST_WEB=http://webapp:3000

# ── Auth (login for API tests) ───────────────────────────────────────────────
# These are used by api_client.py to authenticate
ADMIN_EMAIL=admin@dm3.local
ADMIN_PASSWORD=changeme

# ── Report Upload ────────────────────────────────────────────────────────────
REPORT_UPLOAD_URL=https://tasks.duali.vn/api/automation/upload
REPORT_UPLOAD_TOKEN=
REPORT_PREFIX=dm3

# ── Schedule ─────────────────────────────────────────────────────────────────
# Cron expression for daily full test run (server timezone)
# Default: midnight daily
CRON_SCHEDULE=0 0 * * *

# ── Timezone ─────────────────────────────────────────────────────────────────
TZ=Asia/Bangkok

# ── Startup behavior ────────────────────────────────────────────────────────
# What to run when container starts:
#   changed = detect git diff, run only changed modules (default)
#   full    = run full test suite on every container start
#   none    = don't run tests on start, wait for cron
RUN_ON_STARTUP=changed

# ── Options ──────────────────────────────────────────────────────────────────
# Generate video from screenshots (web tests)
GENERATE_VIDEO=true

# Max seconds to wait for services to be healthy before running tests
HEALTH_TIMEOUT=120
