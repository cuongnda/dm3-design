# DM3 Automation Configuration
# Copy to .env and fill in values.
#
# SECURITY: never commit a filled-in .env. Never share a .env across
# environments. Passwords below must be unique per environment — the
# default literals ("admin123" etc.) are explicitly NOT safe for any
# non-localhost target. If you point BASE_URL/API_URL at a shared or
# remote host, rotate every credential in this file first.

# ── Test Target ──────────────────────────────
BASE_URL=http://localhost:3000
API_URL=http://localhost:8005

# ── Test Credentials (LOCAL ONLY — rotate for any shared host) ──
# The real .env should set strong values here. These placeholders exist
# only so a fresh clone has a visible schema; they are NOT defaults to
# be used in practice.
SYSADMIN_EMAIL=sysadmin@example.test
SYSADMIN_PASSWORD=replace-me-with-a-strong-password
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-me-with-a-strong-password

# ── Report Upload (DV Tasks Server API) ─────
REPORT_UPLOAD_URL=http://demo.demasterpro.com:5001/api/automation/upload
REPORT_UPLOAD_TOKEN=
REPORT_PREFIX=dm3

# ── Bug Reporter (for backend services) ─────
BUG_REPORTER_ENABLED=true
BUG_REPORTER_URL=https://tasks.duali.vn/api
BUG_REPORTER_TOKEN=
BUG_REPORTER_PROJECT_ID=51e00fe3-f950-4682-8199-1df6ba9e71ac
BUG_REPORTER_SPRINT_ID=6b8b632f-5911-408b-b104-ba250e9e76dc
BUG_REPORTER_ASSIGNEE_ID=c776d5d1-189f-43f4-96f8-f8c95eecb717
