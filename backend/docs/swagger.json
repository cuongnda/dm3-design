                        "schema": {
                            "$ref": "#/definitions/github_com_duali_dm3-backend_pkg_httputil.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/audit/export": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
