{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Auth Service",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/backend/cmd/auth-svc",
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "HTTP_PORT": "8005",
        "DATABASE_URL": "postgres://dm3:dm3secret@localhost:5433/dm3?sslmode=disable",
        "NATS_URL": "nats://localhost:4222",
        "JWT_SECRET": "dm3-dev-secret-key",
        "VALKEY_URL": "localhost:6380"
      }
    },
    {
      "name": "Identity Service",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/backend/cmd/identity-svc",
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "HTTP_PORT": "8004",
        "DATABASE_URL": "postgres://dm3:dm3secret@localhost:5433/dm3?sslmode=disable",
        "NATS_URL": "nats://localhost:4222",
        "JWT_SECRET": "dm3-dev-secret-key",
        "VALKEY_URL": "localhost:6380",
        "OBJECT_STORE_ENDPOINT": "localhost:9002",
        "OBJECT_STORE_ACCESS_KEY": "dm3admin",
        "OBJECT_STORE_SECRET_KEY": "dm3secret123",
        "OBJECT_STORE_BUCKET": "dm3",
        "OBJECT_STORE_USE_SSL": "false",
        "OBJECT_STORE_AUTO_CREATE_BUCKET": "true"
      }
    },
    {
      "name": "Access Service",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/backend/cmd/access-svc",
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "HTTP_PORT": "8003",
        "DATABASE_URL": "postgres://dm3:dm3secret@localhost:5433/dm3?sslmode=disable",
        "NATS_URL": "nats://localhost:4222",
        "JWT_SECRET": "dm3-dev-secret-key",
        "VALKEY_URL": "localhost:6380",
        "OBJECT_STORE_ENDPOINT": "localhost:9002",
        "OBJECT_STORE_ACCESS_KEY": "dm3admin",
        "OBJECT_STORE_SECRET_KEY": "dm3secret123",
        "OBJECT_STORE_BUCKET": "dm3",
        "OBJECT_STORE_USE_SSL": "false",
        "OBJECT_STORE_AUTO_CREATE_BUCKET": "true"
      }
    },
    {
      "name": "Device Gateway",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/backend/cmd/device-gateway",
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "HTTP_PORT": "8002",
        "DATABASE_URL": "postgres://dm3:dm3secret@localhost:5433/dm3?sslmode=disable",
        "MQTT_BROKER": "tcp://localhost:1884",
        "MQTT_CLIENT_ID": "dm3-device-gateway-debug",
        "NATS_URL": "nats://localhost:4222",
        "JWT_SECRET": "dm3-dev-secret-key",
        "VALKEY_URL": "localhost:6380",
        "BOOTSTRAP_SECRET": "dm3-bootstrap-v1-dev-secret",
        "OBJECT_STORE_ENDPOINT": "localhost:9002",
        "OBJECT_STORE_ACCESS_KEY": "dm3admin",
        "OBJECT_STORE_SECRET_KEY": "dm3secret123",
        "OBJECT_STORE_BUCKET": "dm3",
        "OBJECT_STORE_USE_SSL": "false",
        "OBJECT_STORE_AUTO_CREATE_BUCKET": "true",
        "FIRMWARE_DOWNLOAD_URL": "http://192.168.1.254:8002"
      }
    },
    {
      "name": "Audit Service",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/backend/cmd/audit-svc",
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "HTTP_PORT": "8001",
        "DATABASE_URL": "postgres://dm3:dm3secret@localhost:5433/dm3?sslmode=disable",
        "NATS_URL": "nats://localhost:4222",
        "JWT_SECRET": "dm3-dev-secret-key"
      }
    },
    {
      "name": "Frontend (React)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "${workspaceFolder}/apps/console",
      "console": "integratedTerminal",
      "env": {
        "BROWSER": "none"
      }
    }
  ],
  "compounds": [
    {
      "name": "All Backend Services",
      "configurations": [
        "Auth Service",
        "Identity Service",
        "Access Service",
        "Device Gateway",
        "Audit Service"
      ]
    }
  ]
}
