        <mxCell id="e17" value="⑰  S3 PUT/GET&#10;tenants/{t}/identity/users/{uid}/photo.{ext}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;startArrow=classic;strokeColor=#15803D;strokeWidth=2;fontSize=11;fontColor=#15803D;exitX=1;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="identity" target="minio">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1175" y="780" />
              <mxPoint x="1175" y="930" />
            </Array>
          </mxGeometry>
        </mxCell>

