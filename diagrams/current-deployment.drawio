        <mxCell id="e18" value="⑱  runs once · exits 0&#10;every app svc depends_on" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#475569;strokeWidth=1;dashed=1;fontSize=11;fontColor=#475569;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=0.95;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="migrate" target="tsdb">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
