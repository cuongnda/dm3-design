        <mxCell id="parking_vehicles" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=2;verticalAlign=top;spacingTop=0;" value="&lt;b style=&#39;color:#D97706&#39;&gt;parking_vehicles&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;font-size:10px;color:#94A3B8&#39;&gt;unified vehicle registry (replaces dm3_identity.vehicles)&lt;/i&gt;&lt;hr size=&#39;1&#39;/&gt;&lt;div style=&#39;text-align:left;font-size:11px;padding:4px&#39;&gt;🔑 id : UUID PK&lt;br/&gt;🔗 tenant_id → tenants&lt;br/&gt;🔗 owner_user_id → identity.users SET NULL&lt;br/&gt;🔗 visitor_id → visitor.visitors (soft FK)&lt;br/&gt;plate_number : VARCHAR(30) NOT NULL&lt;br/&gt;normalized_plate : VARCHAR(30)&lt;br/&gt;plate_image_ref : VARCHAR(500)&lt;br/&gt;rfid_tag : VARCHAR(100)&lt;br/&gt;nfc_card_id : VARCHAR(100)&lt;br/&gt;type : VARCHAR(20) CHECK(car|motorbike|bicycle|truck)&lt;br/&gt;category : VARCHAR(20) CHECK(resident|visitor|temporary)&lt;br/&gt;brand / color : VARCHAR&lt;br/&gt;registration_status : VARCHAR(30)&lt;br/&gt;active_pass_id : UUID&lt;br/&gt;metadata : JSONB&lt;br/&gt;created_at / updated_at&lt;br/&gt;&lt;br/&gt;⚡ UNIQUE(tenant_id, rfid_tag) WHERE NOT NULL&lt;br/&gt;⚡ UNIQUE(tenant_id, nfc_card_id) WHERE NOT NULL&lt;br/&gt;CHECK(owner_user_id IS NULL OR visitor_id IS NULL)&lt;/div&gt;" vertex="1">
          <mxGeometry height="380" width="240" x="1170" y="3640" as="geometry" />
        </mxCell>
        <mxCell id="parking_passes" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=2;verticalAlign=top;spacingTop=0;" value="&lt;b style=&#39;color:#D97706&#39;&gt;parking_passes&lt;/b&gt;&lt;hr size=&#39;1&#39;/&gt;&lt;div style=&#39;text-align:left;font-size:11px;padding:4px&#39;&gt;🔑 id : UUID PK&lt;br/&gt;🔗 tenant_id → tenants&lt;br/&gt;🔗 zone_id → parking_zones CASCADE&lt;br/&gt;🔗 vehicle_id → parking_vehicles CASCADE&lt;br/&gt;🔗 user_id → identity.users SET NULL&lt;br/&gt;lot_id / site_id : UUID&lt;br/&gt;pass_type : VARCHAR(30) def &#39;standard&#39;&lt;br/&gt;valid_from / valid_until : TIMESTAMPTZ&lt;br/&gt;fee_amount : NUMERIC(12,2)&lt;br/&gt;status : VARCHAR(20) def &#39;active&#39;&lt;br/&gt;auto_renew : BOOL def false&lt;br/&gt;metadata : JSONB&lt;br/&gt;created_at / updated_at&lt;/div&gt;" vertex="1">
