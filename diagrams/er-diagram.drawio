        <mxCell id="flow-annotation" parent="1" style="text;html=1;align=center;fillColor=#F0FDF4;strokeColor=#86EFAC;rounded=1;arcSize=10;" value="&lt;div style=&#39;font-size:11px;color:#6B7280;text-align:center&#39;&gt;&lt;b&gt;Access Control Flow&lt;/b&gt;&lt;br/&gt;identity.users → access_group_users → access_groups → access_group_access_points → access_points → devices&lt;br/&gt;&lt;i&gt;WHO → GROUP → WHERE → DEVICE&lt;/i&gt;&lt;br/&gt;Schedule: access_groups.access_time_id (Access Time) · access_points.access_time_id (Passage Time) → access_time_slots&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="580" x="60" y="1790" as="geometry" />
        </mxCell>
        <mxCell id="emergency_plans" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=2;verticalAlign=top;spacingTop=0;" value="&lt;b style=&#39;color:#DC2626&#39;&gt;emergency_plans&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;font-size:10px;color:#94A3B8&#39;&gt;one-click emergency actions (migration 024)&lt;/i&gt;&lt;hr size=&#39;1&#39;/&gt;&lt;div style=&#39;text-align:left;font-size:11px;padding:4px&#39;&gt;🔑 id : UUID PK&lt;br/&gt;🔗 tenant_id → tenants&lt;br/&gt;name : TEXT NOT NULL&lt;br/&gt;description : TEXT def &#39;&#39;&lt;br/&gt;icon : TEXT def &#39;shield-alert&#39;&lt;br/&gt;color : TEXT def &#39;#EF4444&#39;&lt;br/&gt;action : TEXT CHECK(unlock|lock|hold_open|hold_close)&lt;br/&gt;target_type : TEXT def &#39;all&#39;&lt;br/&gt;&lt;i style=&#39;font-size:10px&#39;&gt;(all | zone | access_point | device)&lt;/i&gt;&lt;br/&gt;target_ids : TEXT[] def &#39;{}&#39;&lt;br/&gt;countdown_seconds : INT def 5&lt;br/&gt;enabled : BOOL def true&lt;br/&gt;sort_order : INT def 0&lt;br/&gt;created_by : UUID&lt;br/&gt;created_at / updated_at&lt;/div&gt;" vertex="1">
