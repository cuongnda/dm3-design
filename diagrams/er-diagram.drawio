        <mxCell id="accounts" value="&lt;b style='color:#6B7280'&gt;accounts&lt;/b&gt;&lt;hr size='1'/&gt;&lt;div style='text-align:left;font-size:11px;padding:4px'&gt;🔑 id : UUID PK&lt;br/&gt;🔗 tenant_id → tenants (nullable)&lt;br/&gt;email : VARCHAR(255)&lt;br/&gt;password_hash : VARCHAR(255)&lt;br/&gt;first_name / last_name / full_name&lt;br/&gt;role : CHECK (system_admin | primary_manager | manager | operator | viewer)&lt;br/&gt;permissions : TEXT[]&lt;br/&gt;status : CHECK (active | inactive | suspended | deleted)&lt;br/&gt;email_verified : BOOL&lt;br/&gt;phone, avatar_url, locale, timezone&lt;br/&gt;two_factor_enabled : BOOL&lt;br/&gt;last_login : TZ · login_count : INT&lt;br/&gt;created_at / updated_at&lt;br/&gt;created_by / updated_by : UUID&lt;br/&gt;&lt;br/&gt;&lt;i style='font-size:10px'&gt;⚡ UNIQUE(email, tenant_id) WHERE tenant_id IS NOT NULL&lt;br/&gt;⚡ UNIQUE(email) WHERE tenant_id IS NULL&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;strokeWidth=2;verticalAlign=top;spacingTop=0;" vertex="1" parent="1">
