        <mxCell id="parking-access-note" parent="1" style="text;html=1;align=center;fillColor=#ECFDF5;strokeColor=#6EE7B7;rounded=1;arcSize=10;fontSize=11;" value="&lt;b&gt;Parking ↔ Access Integration (Phase 1–5, migrations 000010–000012)&lt;/b&gt;&lt;br/&gt;&lt;div style=&#39;text-align:left;padding:6px;font-size:10px;color:#374151&#39;&gt;• &lt;b&gt;Unified vehicle registry&lt;/b&gt;: dm3_identity.vehicles dropped; parking_vehicles now owns RFID + NFC + plate (triple credential)&lt;br/&gt;• &lt;b&gt;Zone hierarchy&lt;/b&gt;: parking_zones.access_zone_id → dm3_access.zones (soft FK, cross-plugin)&lt;br/&gt;• &lt;b&gt;Event bridge&lt;/b&gt;: parking entry/exit → NATS dm3.parking.{tid}.access.{dir} → access-svc ParkingAccessConsumer → dm3_access.access_events (source=parking)&lt;br/&gt;• &lt;b&gt;Barrier auto-registration&lt;/b&gt;: parking_zones sync → NATS dm3.parking.{tid}.zone.barrier_sync → access-svc ParkingBarrierConsumer upserts dm3_access.access_devices (source=parking, source_ref=zone_id, type=barrier) + access_points + access_point_devices&lt;br/&gt;• &lt;b&gt;Access policy check (opt-in)&lt;/b&gt;: parking_settings.enforce_access_rules=true → CreateParkingSession validates user belongs to access_group with access to zone.access_zone_id before allowing entry&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="1000" x="1220" y="3330" as="geometry" />
        </mxCell>
        <mxCell id="rel-lots-zones" edge="1" parent="1" source="parking_lots" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#D97706;endArrow=ERmany;startArrow=ERone;startSize=12;endSize=12;" target="parking_zones">
