        <mxCell id="parking_sessions" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=2;verticalAlign=top;spacingTop=0;" value="&lt;b style=&#39;color:#D97706&#39;&gt;parking_sessions&lt;/b&gt;&lt;hr size=&#39;1&#39;/&gt;&lt;div style=&#39;text-align:left;font-size:11px;padding:4px&#39;&gt;🔑 id : UUID PK&lt;br/&gt;🔗 tenant_id → tenants&lt;br/&gt;🔗 lot_id → parking_lots&lt;br/&gt;🔗 zone_id → parking_zones&lt;br/&gt;🔗 vehicle_id → parking_vehicles SET NULL&lt;br/&gt;plate_number / normalized_plate : VARCHAR(30)&lt;br/&gt;vehicle_type : VARCHAR(20)&lt;br/&gt;vehicle_category : VARCHAR(20)&lt;br/&gt;entry_time : TIMESTAMPTZ NOT NULL&lt;br/&gt;exit_time : TIMESTAMPTZ&lt;br/&gt;entry_device_id / exit_device_id : UUID&lt;br/&gt;entry_plate_image / exit_plate_image : VARCHAR&lt;br/&gt;status : VARCHAR(20) CHECK(active|completed|disputed|void)&lt;br/&gt;fee_amount : NUMERIC(12,2) · fee_currency : VARCHAR(3)&lt;br/&gt;fee_rule_id : UUID · monthly_pass_id : UUID&lt;br/&gt;payment_status / payment_method / payment_ref&lt;br/&gt;matched_by : VARCHAR(30) · recognition_confidence : FLOAT&lt;br/&gt;duration_minutes : BIGINT&lt;br/&gt;metadata : JSONB&lt;br/&gt;created_at / updated_at&lt;/div&gt;" vertex="1">
