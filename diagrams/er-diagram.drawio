        <mxCell id="cctv-label" parent="1" style="text;html=1;fontSize=12;fontStyle=1;align=left;fillColor=none;strokeColor=none;fontColor=#DC2626;" value="dm3_cctv  (plugin-gated: RequirePlugin(&quot;cctv&quot;))" vertex="1">
