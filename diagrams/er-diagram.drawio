        </mxCell>
        <mxCell id="cctv_cameras" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=2;verticalAlign=top;spacingTop=0;" value="&lt;b style=&#39;color:#DC2626&#39;&gt;cameras&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;font-size:10px;color:#94A3B8&#39;&gt;1-1 extension of dm3_devices.devices (type=&#39;camera&#39;)&lt;/i&gt;&lt;hr size=&#39;1&#39;/&gt;&lt;div style=&#39;text-align:left;font-size:11px;padding:4px&#39;&gt;🔑 device_id : UUID PK&lt;br/&gt;🔗 device_id → dm3_devices.devices CASCADE&lt;br/&gt;🔗 tenant_id → tenants&lt;br/&gt;rtsp_url : TEXT NOT NULL&lt;br/&gt;rtsp_username : TEXT&lt;br/&gt;rtsp_password_enc : BYTEA&lt;br/&gt;&lt;i style=&#39;font-size:10px&#39;&gt;(AES-GCM ciphertext, never logged)&lt;/i&gt;&lt;br/&gt;brand : VARCHAR(100)&lt;br/&gt;recording_mode : VARCHAR(20) CHECK(event_only|disabled)&lt;br/&gt;pre_roll_sec : INT def 10 (0..60)&lt;br/&gt;post_roll_sec : INT def 20 (0..120)&lt;br/&gt;stream_profile : JSONB&lt;br/&gt;last_checked_at : TIMESTAMPTZ&lt;br/&gt;created_at / updated_at&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="270" x="1720" y="3650" as="geometry" />
        </mxCell>
        <mxCell id="cctv_event_clips" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=2;verticalAlign=top;spacingTop=0;" value="&lt;b style=&#39;color:#DC2626&#39;&gt;event_clips&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;font-size:10px;color:#94A3B8&#39;&gt;TimescaleDB hypertable (chunk 7 days)&lt;/i&gt;&lt;hr size=&#39;1&#39;/&gt;&lt;div style=&#39;text-align:left;font-size:11px;padding:4px&#39;&gt;🔑 (id, started_at) PK&lt;br/&gt;🔗 tenant_id → tenants&lt;br/&gt;device_id : UUID NOT NULL&lt;br/&gt;&lt;i style=&#39;font-size:10px&#39;&gt;(soft ref → dm3_devices.devices; no hard FK so clip retention survives camera deletion)&lt;/i&gt;&lt;br/&gt;access_event_id : UUID (nullable)&lt;br/&gt;&lt;i style=&#39;font-size:10px&#39;&gt;(soft FK → dm3_access.access_events; nullable for manual / api clips)&lt;/i&gt;&lt;br/&gt;started_at : TIMESTAMPTZ NOT NULL&lt;br/&gt;ended_at : TIMESTAMPTZ NOT NULL&lt;br/&gt;duration_ms : INT NOT NULL&lt;br/&gt;object_key : TEXT NOT NULL&lt;br/&gt;&lt;i style=&#39;font-size:10px&#39;&gt;(MinIO: cctv-&lt;tenant&gt;/yyyy/mm/dd/&lt;cam&gt;/&lt;clip&gt;.mp4)&lt;/i&gt;&lt;br/&gt;trigger : VARCHAR(20) CHECK(access_event|manual|api)&lt;br/&gt;created_at&lt;/div&gt;" vertex="1">
          <mxGeometry height="380" width="290" x="2030" y="3650" as="geometry" />
        </mxCell>
        <mxCell id="cctv_settings" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=2;verticalAlign=top;spacingTop=0;" value="&lt;b style=&#39;color:#DC2626&#39;&gt;cctv_settings&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;font-size:10px;color:#94A3B8&#39;&gt;per-tenant config (lazy-created on plugin enable)&lt;/i&gt;&lt;hr size=&#39;1&#39;/&gt;&lt;div style=&#39;text-align:left;font-size:11px;padding:4px&#39;&gt;🔑 tenant_id : UUID PK&lt;br/&gt;🔗 tenant_id → tenants CASCADE&lt;br/&gt;retention_days : INT def 14 (1..max)&lt;br/&gt;retention_days_max : INT def 90 (1..365)&lt;br/&gt;pre_roll_sec_default : INT def 10&lt;br/&gt;post_roll_sec_default : INT def 20&lt;br/&gt;storage_quota_gb : INT def 100&lt;br/&gt;created_at / updated_at&lt;/div&gt;" vertex="1">
          <mxGeometry height="240" width="260" x="2360" y="3650" as="geometry" />
        </mxCell>
        <mxCell id="rel-cctv-cameras-devices" edge="1" parent="1" source="cctv_cameras" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#DC2626;endArrow=ERone;startArrow=ERone;startSize=12;endSize=12;" target="devices">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel-cctv-clips-events" edge="1" parent="1" source="cctv_event_clips" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10B981;strokeWidth=2;dashed=1;dashPattern=8 4;endArrow=ERone;startArrow=ERmany;startSize=12;endSize=12;" target="access_events">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cctv-access-note" parent="1" style="text;html=1;align=center;fillColor=#FEF2F2;strokeColor=#FCA5A5;rounded=1;arcSize=10;fontSize=11;" value="&lt;b&gt;CCTV ↔ Access Integration (migration 000013, cctv-svc plugin)&lt;/b&gt;&lt;br/&gt;&lt;div style=&#39;text-align:left;padding:6px;font-size:10px;color:#374151&#39;&gt;• &lt;b&gt;Camera is a device&lt;/b&gt;: cameras.device_id is both PK and FK to dm3_devices.devices (type=&#39;camera&#39;). Name, tenant, status, last_seen live on the base device row.&lt;br/&gt;• &lt;b&gt;Access-point binding&lt;/b&gt;: cameras attach to access_points via existing dm3_access.access_devices junction — no new cross-plugin link table. UI queries access-points-all when configuring cameras.&lt;br/&gt;• &lt;b&gt;Clip↔event correlation&lt;/b&gt;: event_clips.access_event_id is a soft FK (UUID, no hard constraint) into dm3_access.access_events. Access-history pages query GET /api/v1/cctv/clips?access_event_id=… to surface footage.&lt;br/&gt;• &lt;b&gt;Event-driven clip trigger&lt;/b&gt;: access-svc publishes access events to NATS; cctv-svc consumes + creates clips asynchronously (trigger=&#39;access_event&#39;). No direct service-to-service call — decoupled via NATS.&lt;br/&gt;• &lt;b&gt;Storage&lt;/b&gt;: clip blobs in MinIO (presigned URLs); metadata in TimescaleDB hypertable (7-day chunks, retention worker prunes per cctv_settings.retention_days).&lt;br/&gt;• &lt;b&gt;Credentials&lt;/b&gt;: RTSP password encrypted in Go (AES-GCM, env key) — pgcrypto intentionally not enabled.&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="1010" x="1720" y="4020" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
