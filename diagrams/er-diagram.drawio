        <mxCell id="credentials" value="&lt;b style='color:#8B5CF6'&gt;credentials&lt;/b&gt;&lt;hr size='1'/&gt;&lt;div style='text-align:left;font-size:11px;padding:4px'&gt;🔑 id : UUID PK&lt;br/&gt;🔗 tenant_id → tenants&lt;br/&gt;🔗 user_id → users CASCADE&lt;br/&gt;type : VARCHAR(50) NOT NULL&lt;br/&gt;value : TEXT NOT NULL&lt;br/&gt;status : VARCHAR(20) def 'active'&lt;br/&gt;valid_from / valid_until : TZ&lt;br/&gt;created_at / updated_at&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=2;verticalAlign=top;spacingTop=0;" vertex="1" parent="1">
