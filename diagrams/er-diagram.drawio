          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel-att-balances-policies" edge="1" parent="1" source="att_leave_balances" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#D97706;endArrow=ERone;startArrow=ERmany;startSize=12;endSize=12;" target="att_leave_policies">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel-att-requests-policies" edge="1" parent="1" source="att_leave_requests" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#D97706;endArrow=ERone;startArrow=ERmany;startSize=12;endSize=12;" target="att_leave_policies">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel-att-records-events" edge="1" parent="1" source="att_records" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#F59E0B;strokeWidth=2;dashed=1;dashPattern=2 2;endArrow=ERmany;startArrow=ERmany;startSize=12;endSize=12;" target="access_events">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
