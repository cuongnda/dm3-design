        <mxCell id="flow-annotation" parent="1" style="text;html=1;align=center;fillColor=#F0FDF4;strokeColor=#86EFAC;rounded=1;arcSize=10;" value="&lt;div style=&#39;font-size:11px;color:#6B7280;text-align:center&#39;&gt;&lt;b&gt;Access Control Flow&lt;/b&gt;&lt;br/&gt;identity.users → access_group_users → access_groups → access_group_access_points → access_points → devices&lt;br/&gt;&lt;i&gt;WHO → GROUP → WHERE → DEVICE&lt;/i&gt;&lt;br/&gt;Schedule: access_groups.access_time_id (Access Time) · access_points.access_time_id (Passage Time) → access_time_slots&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="580" x="600" y="1930" as="geometry" />
        </mxCell>
        <mxCell id="visitors_table" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=2;verticalAlign=top;spacingTop=0;" value="&lt;b style=&#39;color:#8B5CF6&#39;&gt;visitors&lt;/b&gt;&lt;hr size=&#39;1&#39;/&gt;&lt;div style=&#39;text-align:left;font-size:11px;padding:4px&#39;&gt;🔑 id : UUID PK&lt;br/&gt;🔗 tenant_id → tenants&lt;br/&gt;first_name / last_name : VARCHAR(100)&lt;br/&gt;display_name : GENERATED&lt;br/&gt;email : VARCHAR(255)&lt;br/&gt;phone : VARCHAR(20)&lt;br/&gt;company : VARCHAR(200)&lt;br/&gt;national_id : VARCHAR(30)&lt;br/&gt;photo_ref : VARCHAR(500)&lt;br/&gt;watchlist_status : VARCHAR(20) def &amp;#39;none&amp;#39;&lt;br/&gt;watchlist_reason : TEXT&lt;br/&gt;visit_count : INT def 0&lt;br/&gt;last_visit_at : TIMESTAMPTZ&lt;br/&gt;created_at / updated_at&lt;br/&gt;&lt;br/&gt;⚡ UNIQUE(tenant_id, email) WHERE email NOT NULL&lt;br/&gt;⚡ UNIQUE(tenant_id, phone) WHERE phone NOT NULL&lt;/div&gt;" vertex="1">
          <mxGeometry height="300" width="220" x="60" y="1440" as="geometry" />
        </mxCell>
        <mxCell id="visits_table" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=2;verticalAlign=top;spacingTop=0;" value="&lt;b style=&#39;color:#8B5CF6&#39;&gt;visits&lt;/b&gt;&lt;hr size=&#39;1&#39;/&gt;&lt;div style=&#39;text-align:left;font-size:11px;padding:4px&#39;&gt;🔑 id : UUID PK&lt;br/&gt;🔗 tenant_id → tenants&lt;br/&gt;🔗 visitor_id → visitors&lt;br/&gt;🔗 group_id → visit_groups (nullable)&lt;br/&gt;🔗 recurring_template_id → recurring_templates (nullable)&lt;br/&gt;host_user_id : UUID NOT NULL&lt;br/&gt;purpose : VARCHAR(30) CHECK(...)&lt;br/&gt;purpose_note : VARCHAR(500)&lt;br/&gt;status : VARCHAR(20) def &amp;#39;pre_registered&amp;#39;&lt;br/&gt;expected_arrival / expected_departure : TZ&lt;br/&gt;actual_checkin / actual_checkout : TZ&lt;br/&gt;checkin_method : VARCHAR(30)&lt;br/&gt;checkin_device_id / checkout_by : UUID&lt;br/&gt;qr_token : VARCHAR(64) UNIQUE&lt;br/&gt;qr_expires_at : TIMESTAMPTZ&lt;br/&gt;badge_number : VARCHAR(20)&lt;br/&gt;temp_credential_id : UUID&lt;br/&gt;access_areas : UUID[]&lt;br/&gt;escort_required : BOOL def false&lt;br/&gt;vehicle_plate : VARCHAR(20)&lt;br/&gt;nda_signed / host_approved : BOOL&lt;br/&gt;host_approved_at / approved_by : UUID&lt;br/&gt;cancelled_reason / rejection_reason : VARCHAR(200)&lt;br/&gt;checkout_reason : VARCHAR(30) def &amp;#39;manual&amp;#39;&lt;br/&gt;reinvite_count : INT def 0&lt;br/&gt;notes : TEXT&lt;br/&gt;created_at / updated_at&lt;/div&gt;" vertex="1">
          <mxGeometry height="510" width="230" x="310" y="1440" as="geometry" />
        </mxCell>
        <mxCell id="visitor_badges_table" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=2;verticalAlign=top;spacingTop=0;" value="&lt;b style=&#39;color:#8B5CF6&#39;&gt;visitor_badges&lt;/b&gt;&lt;hr size=&#39;1&#39;/&gt;&lt;div style=&#39;text-align:left;font-size:11px;padding:4px&#39;&gt;🔑 id : UUID PK&lt;br/&gt;🔗 tenant_id → tenants&lt;br/&gt;🔗 visit_id → visits&lt;br/&gt;badge_number : VARCHAR(20)&lt;br/&gt;badge_type : VARCHAR(20) CHECK(...)&lt;br/&gt;issued_at : TIMESTAMPTZ def now()&lt;br/&gt;returned_at : TIMESTAMPTZ&lt;br/&gt;printed : BOOL def false&lt;br/&gt;print_data : JSONB&lt;/div&gt;" vertex="1">
