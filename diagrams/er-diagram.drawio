          <mxGeometry height="340" width="230" x="1100" y="400" as="geometry" />
        </mxCell>
        <mxCell id="access_group_access_points" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#3B82F6;strokeWidth=1;verticalAlign=top;spacingTop=0;" value="&lt;b style=&#39;color:#3B82F6&#39;&gt;access_group_access_points&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;font-size:10px;color:#94A3B8&#39;&gt;junction: AG → AP (simple link, no time override)&lt;/i&gt;&lt;hr size=&#39;1&#39;/&gt;&lt;div style=&#39;text-align:left;font-size:11px;padding:4px&#39;&gt;🔑 id : UUID PK&lt;br/&gt;🔗 tenant_id → tenants&lt;br/&gt;🔗 access_group_id → access_groups CASCADE&lt;br/&gt;🔗 access_point_id → access_points CASCADE&lt;br/&gt;⚡ UNIQUE(access_group_id, access_point_id)&lt;br/&gt;created_at&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="270" x="600" y="710" as="geometry" />
        </mxCell>
        <mxCell id="access_group_users" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#3B82F6;strokeWidth=1;verticalAlign=top;spacingTop=0;" value="&lt;b style=&#39;color:#3B82F6&#39;&gt;access_group_users&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;font-size:10px;color:#94A3B8&#39;&gt;junction: M:N user ↔ access group&lt;/i&gt;&lt;hr size=&#39;1&#39;/&gt;&lt;div style=&#39;text-align:left;font-size:11px;padding:4px&#39;&gt;🔑 id : UUID PK&lt;br/&gt;🔗 tenant_id → tenants&lt;br/&gt;🔗 access_group_id → access_groups CASCADE&lt;br/&gt;🔗 user_id → dm3_identity.users CASCADE&lt;br/&gt;effective_from : TIMESTAMPTZ def now()&lt;br/&gt;effective_to : TIMESTAMPTZ (nullable)&lt;br/&gt;&lt;i style=&#39;font-size:10px&#39;&gt;(NULL = no expiry)&lt;/i&gt;&lt;br/&gt;⚡ UNIQUE(access_group_id, user_id)&lt;br/&gt;created_at&lt;/div&gt;" vertex="1">
          <mxGeometry height="220" width="260" x="1100" y="780" as="geometry" />
        </mxCell>
        <mxCell id="access_events" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;verticalAlign=top;spacingTop=0;" value="&lt;b style=&#39;color:#F59E0B&#39;&gt;access_events ⏱️&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;font-size:10px;color:#94A3B8&#39;&gt;TimescaleDB hypertable&lt;/i&gt;&lt;hr size=&#39;1&#39;/&gt;&lt;div style=&#39;text-align:left;font-size:11px;padding:4px&#39;&gt;🔑 (tenant_id, time, id) PK&lt;br/&gt;tenant_id : UUID def demo UUID&lt;br/&gt;time : TIMESTAMPTZ def now()&lt;br/&gt;access_point_id : UUID (logical)&lt;br/&gt;user_id : UUID (logical)&lt;br/&gt;user_name : VARCHAR(255)&lt;br/&gt;credential_type : VARCHAR(50)&lt;br/&gt;direction : VARCHAR(10)&lt;br/&gt;decision : VARCHAR(20) NOT NULL&lt;br/&gt;reason : VARCHAR(255)&lt;br/&gt;confidence / temperature : FLOAT&lt;br/&gt;photo_ref : VARCHAR(200)&lt;br/&gt;decided_locally : BOOL def true&lt;br/&gt;metadata : JSONB&lt;br/&gt;&lt;br/&gt;&lt;i style=&#39;font-size:10px&#39;&gt;No FK constraints (hypertable).&lt;br/&gt;Logical refs to access_points, users.&lt;/i&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="340" width="270" x="600" y="950" as="geometry" />
        </mxCell>
        <mxCell id="legend-bg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#E5E7EB;arcSize=8;" value="" vertex="1">
          <mxGeometry height="740" width="420" x="1640" y="970" as="geometry" />
        </mxCell>
        <mxCell id="legend-title" parent="1" style="text;html=1;fontSize=13;fontStyle=1;align=left;fillColor=none;strokeColor=none;fontColor=#374151;" value="Legend" vertex="1">
          <mxGeometry height="20" width="120" x="1660" y="985" as="geometry" />
        </mxCell>
        <mxCell id="legend-content" parent="1" style="text;html=1;align=left;fillColor=none;strokeColor=none;" value="&lt;span style=&#39;font-size:11px&#39;&gt;🔑 Primary Key&lt;br/&gt;🔗 Foreign Key (hard FK constraint)&lt;br/&gt;⚡ Unique constraint&lt;br/&gt;⏱️ TimescaleDB hypertable&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Schemas (7)&lt;/b&gt;&lt;br/&gt;&lt;span style=&#39;color:#6B7280&#39;&gt;■&lt;/span&gt; dm3_auth — tenants, accounts, refresh_tokens&lt;br/&gt;&lt;span style=&#39;color:#3B82F6&#39;&gt;■&lt;/span&gt; dm3_devices — devices, firmwares, provisioning&lt;br/&gt;&lt;span style=&#39;color:#3B82F6&#39;&gt;■&lt;/span&gt; dm3_access — access control (8 tables)&lt;br/&gt;&lt;span style=&#39;color:#8B5CF6&#39;&gt;■&lt;/span&gt; dm3_identity — users, departments, credentials (vehicles moved to dm3_parking)&lt;br/&gt;&lt;span style=&#39;color:#059669&#39;&gt;■&lt;/span&gt; dm3_visitor — visitor module (11 tables, independently deployable)&lt;br/&gt;&lt;span style=&#39;color:#F59E0B&#39;&gt;■&lt;/span&gt; dm3_audit — audit_logs (hypertable)&lt;br/&gt;&lt;span style=&#39;color:#D97706&#39;&gt;■&lt;/span&gt; dm3_parking — parking (lots, zones, vehicles, passes, fee_rules, sessions, settings)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Multi-tenancy&lt;/b&gt;: All tables have tenant_id → tenants&lt;br/&gt;(tenant_id edges omitted for readability)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Key changes (migrations 002–009)&lt;/b&gt;&lt;br/&gt;• doors + access_point_doors removed&lt;br/&gt;• access_groups: flat (no parent_id), description added&lt;br/&gt;• access_groups.access_time_id = Access Time (when members can use APs)&lt;br/&gt;• access_points.access_time_id = Passage Time (when door open for all)&lt;br/&gt;• access_group_access_points: simple link (no per-link time override)&lt;br/&gt;• access_group_users: temporal membership (effective_from/to)&lt;br/&gt;• dm3_audit.audit_logs hypertable (migration 006)&lt;br/&gt;• devices: +model, ip_address, mac_address, verify_methods/logic (009)&lt;br/&gt;• zones: +spatial fields, indoor map support (009)&lt;br/&gt;• access_points: +map_x/y/rotation for floor plan placement (009)&lt;br/&gt;• dm3_visitor schema (migration 000005): isolated from dm3_identity&lt;br/&gt;  visitors, visits (v2), visitor_badges, watchlist&lt;br/&gt;• Visitor V2 (migration 000005): visitor_settings, visit_groups,&lt;br/&gt;  recurring_visit_templates, visitor_access_log,&lt;br/&gt;  visitor_agreements, visitor_agreement_signatures&lt;br/&gt;• visits: +group_id, +recurring_template_id, +approved_by,&lt;br/&gt;  +cancelled_reason, +rejection_reason, +checkout_reason, +reinvite_count&lt;br/&gt;• temp_credentials (migration 000006): auto-created on visit approval,&lt;br/&gt;  revoked on checkout/cancellation&lt;br/&gt;• dm3_parking schema: parking_lots, parking_zones, parking_passes,&lt;br/&gt;  parking_vehicles, parking_fee_rules, parking_sessions, parking_settings&lt;br/&gt;• &lt;b&gt;Parking ↔ Access integration (migrations 010–012)&lt;/b&gt;:&lt;br/&gt;  – dm3_identity.vehicles DROPPED; parking_vehicles is the unified registry&lt;br/&gt;  – parking_vehicles +visitor_id, +rfid_tag, +nfc_card_id (triple credential)&lt;br/&gt;  – parking_zones +access_zone_id → dm3_access.zones (soft FK)&lt;br/&gt;  – dm3_access.access_devices +source, +source_ref (auto-registered barriers)&lt;br/&gt;  – parking_settings +enforce_access_rules (opt-in cross-module policy check)&lt;br/&gt;  – NATS event bridge: parking → access_events (source=parking)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Junction tables&lt;/b&gt; shown with thin border + gray fill&lt;br/&gt;&lt;b&gt;Dashed edges&lt;/b&gt; = logical reference (no FK)&lt;br/&gt;&lt;b&gt;Solid edges&lt;/b&gt; = hard FK constraint&lt;/span&gt;" vertex="1">
          <mxGeometry height="560" width="380" x="1660" y="1015" as="geometry" />
        </mxCell>
        <mxCell id="audit-bg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FDBA74;dashed=1;arcSize=4;" value="" vertex="1">
          <mxGeometry height="250" width="530" x="580" y="2050" as="geometry" />
        </mxCell>
        <mxCell id="audit-label" parent="1" style="text;html=1;fontSize=12;fontStyle=1;align=left;fillColor=none;strokeColor=none;fontColor=#F59E0B;" value="dm3_audit" vertex="1">
          <mxGeometry height="20" width="150" x="595" y="2058" as="geometry" />
        </mxCell>
        <mxCell id="audit_logs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;verticalAlign=top;spacingTop=0;" value="&lt;b style=&#39;color:#F59E0B&#39;&gt;audit_logs ⏱️&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;font-size:10px;color:#94A3B8&#39;&gt;TimescaleDB hypertable&lt;/i&gt;&lt;hr size=&#39;1&#39;/&gt;&lt;div style=&#39;text-align:left;font-size:11px;padding:4px&#39;&gt;🔑 (id, time) PK&lt;br/&gt;id : UUID def gen_random_uuid()&lt;br/&gt;time : TIMESTAMPTZ def now()&lt;br/&gt;tenant_id : UUID (nullable)&lt;br/&gt;actor_id : UUID · actor_email : VARCHAR&lt;br/&gt;actor_ip : INET · user_agent : TEXT&lt;br/&gt;service : VARCHAR(50) NOT NULL&lt;br/&gt;action : VARCHAR(100) NOT NULL&lt;br/&gt;entity_type : VARCHAR(50) NOT NULL&lt;br/&gt;entity_id : VARCHAR(255)&lt;br/&gt;entity_name : VARCHAR(255)&lt;br/&gt;status : VARCHAR(20) def &#39;success&#39;&lt;br/&gt;old_values / new_values : JSONB&lt;br/&gt;metadata : JSONB def &#39;{}&#39;&lt;br/&gt;&lt;br/&gt;&lt;i style=&#39;font-size:10px&#39;&gt;Chunk: 7 days · Compress: 30 days · Retain: 2 years&lt;br/&gt;INSERT+SELECT only (no UPDATE/DELETE)&lt;/i&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="290" width="490" x="600" y="2090" as="geometry" />
        </mxCell>
