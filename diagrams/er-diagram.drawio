        <mxCell id="audit_logs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;verticalAlign=top;spacingTop=0;" value="&lt;b style=&#39;color:#F59E0B&#39;&gt;audit_logs ⏱️&lt;/b&gt;&lt;br/&gt;&lt;i style=&#39;font-size:10px;color:#94A3B8&#39;&gt;TimescaleDB hypertable&lt;/i&gt;&lt;hr size=&#39;1&#39;/&gt;&lt;div style=&#39;text-align:left;font-size:11px;padding:4px&#39;&gt;🔑 (id, time) PK&lt;br/&gt;id : UUID def gen_random_uuid()&lt;br/&gt;time : TIMESTAMPTZ def now()&lt;br/&gt;tenant_id : UUID (nullable)&lt;br/&gt;actor_id : UUID · actor_email : VARCHAR&lt;br/&gt;actor_ip : INET · user_agent : TEXT&lt;br/&gt;service : VARCHAR(50) NOT NULL&lt;br/&gt;action : VARCHAR(100) NOT NULL&lt;br/&gt;entity_type : VARCHAR(50) NOT NULL&lt;br/&gt;entity_id : VARCHAR(255)&lt;br/&gt;entity_name : VARCHAR(255)&lt;br/&gt;status : VARCHAR(20) def &#39;success&#39;&lt;br/&gt;old_values / new_values : JSONB&lt;br/&gt;metadata : JSONB def &#39;{}&#39;&lt;br/&gt;&lt;br/&gt;&lt;i style=&#39;font-size:10px&#39;&gt;Chunk: 7 days · Compress: 30 days · Retain: 2 years&lt;br/&gt;INSERT+SELECT only (no UPDATE/DELETE)&lt;/i&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="290" width="490" x="600" y="1490" as="geometry" />
        </mxCell>
