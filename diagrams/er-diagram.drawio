          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel-devices-apdevices" edge="1" parent="1" source="devices" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10B981;strokeWidth=2;endArrow=ERmany;startArrow=ERone;startSize=12;endSize=12;" target="access_point_devices">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
