          <mxGeometry x="595" y="108" width="150" height="20" as="geometry"/>
        </mxCell>

        <!-- Row 1: WHO / WHEN / WHERE -->
        <mxCell id="access_groups" value="&lt;b style='color:#3B82F6'&gt;access_groups&lt;/b&gt;&lt;br/&gt;&lt;i style='font-size:10px;color:#94A3B8'&gt;WHO can access&lt;/i&gt;&lt;hr size='1'/&gt;&lt;div style='text-align:left;font-size:11px;padding:4px'&gt;🔑 id : UUID PK&lt;br/&gt;🔗 tenant_id → tenants&lt;br/&gt;🔗 parent_id → access_groups (self)&lt;br/&gt;name : VARCHAR(255) NOT NULL&lt;br/&gt;is_default : BOOL def false&lt;br/&gt;type : SMALLINT def 1&lt;br/&gt;is_deleted : BOOL def false&lt;br/&gt;created_at / updated_at&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=2;verticalAlign=top;spacingTop=0;" vertex="1" parent="1">
          <mxGeometry x="600" y="150" width="220" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="access_times" value="&lt;b style='color:#3B82F6'&gt;access_times&lt;/b&gt;&lt;br/&gt;&lt;i style='font-size:10px;color:#94A3B8'&gt;WHEN access is allowed&lt;/i&gt;&lt;hr size='1'/&gt;&lt;div style='text-align:left;font-size:11px;padding:4px'&gt;🔑 id : UUID PK&lt;br/&gt;🔗 tenant_id → tenants&lt;br/&gt;name : VARCHAR(100) NOT NULL&lt;br/&gt;description : TEXT&lt;br/&gt;timezone : VARCHAR(50) def 'Asia/Ho_Chi_Minh'&lt;br/&gt;is_active : BOOL def true&lt;br/&gt;created_by : UUID&lt;br/&gt;⚡ UNIQUE(tenant_id, name)&lt;br/&gt;created_at / updated_at&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=2;verticalAlign=top;spacingTop=0;" vertex="1" parent="1">
          <mxGeometry x="850" y="150" width="220" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="zones" value="&lt;b style='color:#3B82F6'&gt;zones&lt;/b&gt;&lt;br/&gt;&lt;i style='font-size:10px;color:#94A3B8'&gt;WHERE (organizational grouping)&lt;/i&gt;&lt;hr size='1'/&gt;&lt;div style='text-align:left;font-size:11px;padding:4px'&gt;🔑 id : UUID PK&lt;br/&gt;🔗 tenant_id → tenants&lt;br/&gt;🔗 parent_id → zones (self) SET NULL&lt;br/&gt;name : VARCHAR(255) NOT NULL&lt;br/&gt;description : VARCHAR(500)&lt;br/&gt;created_at / updated_at&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=2;verticalAlign=top;spacingTop=0;" vertex="1" parent="1">
          <mxGeometry x="1330" y="150" width="210" height="190" as="geometry"/>
        </mxCell>

        <!-- Row 2: Core access entities -->
        <mxCell id="access_time_slots" value="&lt;b style='color:#3B82F6'&gt;access_time_slots&lt;/b&gt;&lt;hr size='1'/&gt;&lt;div style='text-align:left;font-size:11px;padding:4px'&gt;🔑 id : UUID PK&lt;br/&gt;🔗 tenant_id → tenants CASCADE&lt;br/&gt;🔗 access_time_id → access_times CASCADE&lt;br/&gt;day_of_week : INT CHECK(0–6)&lt;br/&gt;start_time : TIME NOT NULL&lt;br/&gt;end_time : TIME NOT NULL&lt;br/&gt;slot_name : VARCHAR(50)&lt;br/&gt;is_active : BOOL def true&lt;br/&gt;CHECK(start_time &amp;lt; end_time)&lt;br/&gt;⚡ UNIQUE(access_time_id, day, start, end)&lt;br/&gt;created_at&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=2;verticalAlign=top;spacingTop=0;" vertex="1" parent="1">
          <mxGeometry x="850" y="410" width="220" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="access_points" value="&lt;b style='color:#3B82F6'&gt;access_points&lt;/b&gt;&lt;br/&gt;&lt;i style='font-size:10px;color:#94A3B8'&gt;Single entrance = one device&lt;/i&gt;&lt;hr size='1'/&gt;&lt;div style='text-align:left;font-size:11px;padding:4px'&gt;🔑 id : UUID PK&lt;br/&gt;🔗 tenant_id → tenants&lt;br/&gt;🔗 zone_id → zones SET NULL&lt;br/&gt;🔗 access_time_id → access_times SET NULL&lt;br/&gt;&lt;i style='font-size:10px'&gt;(NULL = 24/7 unrestricted)&lt;/i&gt;&lt;br/&gt;🔗 device_id → dm3_devices.devices&lt;br/&gt;name : VARCHAR(255) NOT NULL&lt;br/&gt;description : VARCHAR(500)&lt;br/&gt;status : VARCHAR(20) def 'offline'&lt;br/&gt;state : VARCHAR(20) def 'locked'&lt;br/&gt;mode : VARCHAR(20) def 'normal'&lt;br/&gt;anti_passback : BOOL def false&lt;br/&gt;unlock_duration_ms : INT def 5000&lt;br/&gt;last_event_at : TIMESTAMPTZ&lt;br/&gt;created_at / updated_at&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=2;verticalAlign=top;spacingTop=0;" vertex="1" parent="1">
          <mxGeometry x="1100" y="400" width="230" height="340" as="geometry"/>
        </mxCell>

        <!-- Row 3: Junction tables -->
        <mxCell id="access_group_access_points" value="&lt;b style='color:#3B82F6'&gt;access_group_access_points&lt;/b&gt;&lt;br/&gt;&lt;i style='font-size:10px;color:#94A3B8'&gt;junction: WHO → WHERE + WHEN override&lt;/i&gt;&lt;hr size='1'/&gt;&lt;div style='text-align:left;font-size:11px;padding:4px'&gt;🔑 id : UUID PK&lt;br/&gt;🔗 tenant_id → tenants&lt;br/&gt;🔗 access_group_id → access_groups CASCADE&lt;br/&gt;🔗 access_point_id → access_points CASCADE&lt;br/&gt;🔗 access_time_id → access_times SET NULL&lt;br/&gt;&lt;i style='font-size:10px'&gt;(override schedule; NULL = use AP default)&lt;/i&gt;&lt;br/&gt;⚡ UNIQUE(access_group_id, access_point_id)&lt;br/&gt;created_at&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#3B82F6;strokeWidth=1;verticalAlign=top;spacingTop=0;" vertex="1" parent="1">
          <mxGeometry x="600" y="680" width="270" height="210" as="geometry"/>
        </mxCell>

        <mxCell id="access_group_users" value="&lt;b style='color:#3B82F6'&gt;access_group_users&lt;/b&gt;&lt;br/&gt;&lt;i style='font-size:10px;color:#94A3B8'&gt;junction: M:N user ↔ access group&lt;/i&gt;&lt;hr size='1'/&gt;&lt;div style='text-align:left;font-size:11px;padding:4px'&gt;🔑 id : UUID PK&lt;br/&gt;🔗 tenant_id → tenants&lt;br/&gt;🔗 access_group_id → access_groups CASCADE&lt;br/&gt;🔗 user_id → dm3_identity.users CASCADE&lt;br/&gt;effective_from : TIMESTAMPTZ def now()&lt;br/&gt;effective_to : TIMESTAMPTZ (nullable)&lt;br/&gt;&lt;i style='font-size:10px'&gt;(NULL = no expiry)&lt;/i&gt;&lt;br/&gt;⚡ UNIQUE(access_group_id, user_id)&lt;br/&gt;created_at&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#3B82F6;strokeWidth=1;verticalAlign=top;spacingTop=0;" vertex="1" parent="1">
          <mxGeometry x="1100" y="780" width="260" height="220" as="geometry"/>
        </mxCell>

        <!-- Row 4: Events (hypertable) -->
        <mxCell id="access_events" value="&lt;b style='color:#F59E0B'&gt;access_events ⏱️&lt;/b&gt;&lt;br/&gt;&lt;i style='font-size:10px;color:#94A3B8'&gt;TimescaleDB hypertable&lt;/i&gt;&lt;hr size='1'/&gt;&lt;div style='text-align:left;font-size:11px;padding:4px'&gt;🔑 (tenant_id, time, id) PK&lt;br/&gt;tenant_id : UUID def demo UUID&lt;br/&gt;time : TIMESTAMPTZ def now()&lt;br/&gt;access_point_id : UUID (logical)&lt;br/&gt;user_id : UUID (logical)&lt;br/&gt;user_name : VARCHAR(255)&lt;br/&gt;credential_type : VARCHAR(50)&lt;br/&gt;direction : VARCHAR(10)&lt;br/&gt;decision : VARCHAR(20) NOT NULL&lt;br/&gt;reason : VARCHAR(255)&lt;br/&gt;confidence / temperature : FLOAT&lt;br/&gt;photo_ref : VARCHAR(200)&lt;br/&gt;decided_locally : BOOL def true&lt;br/&gt;metadata : JSONB&lt;br/&gt;&lt;br/&gt;&lt;i style='font-size:10px'&gt;No FK constraints (hypertable).&lt;br/&gt;Logical refs to access_points, users.&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;verticalAlign=top;spacingTop=0;" vertex="1" parent="1">
          <mxGeometry x="600" y="950" width="270" height="340" as="geometry"/>
        </mxCell>

        <!-- ═══════════════════ LEGEND ═══════════════════ -->
        <mxCell id="legend-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#E5E7EB;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1640" y="870" width="420" height="400" as="geometry"/>
        </mxCell>
        <mxCell id="legend-title" value="Legend" style="text;html=1;fontSize=13;fontStyle=1;align=left;fillColor=none;strokeColor=none;fontColor=#374151;" vertex="1" parent="1">
          <mxGeometry x="1660" y="885" width="120" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="legend-content" value="&lt;span style='font-size:11px'&gt;🔑 Primary Key&lt;br/&gt;🔗 Foreign Key (hard FK constraint)&lt;br/&gt;⚡ Unique constraint&lt;br/&gt;⏱️ TimescaleDB hypertable&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Schemas (5)&lt;/b&gt;&lt;br/&gt;&lt;span style='color:#6B7280'&gt;■&lt;/span&gt; dm3_auth — tenants, accounts, refresh_tokens&lt;br/&gt;&lt;span style='color:#3B82F6'&gt;■&lt;/span&gt; dm3_devices — devices, firmwares, provisioning&lt;br/&gt;&lt;span style='color:#3B82F6'&gt;■&lt;/span&gt; dm3_access — access control (8 tables)&lt;br/&gt;&lt;span style='color:#8B5CF6'&gt;■&lt;/span&gt; dm3_identity — users, departments, credentials&lt;br/&gt;&lt;span style='color:#F59E0B'&gt;■&lt;/span&gt; dm3_audit — audit_logs (hypertable)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Multi-tenancy&lt;/b&gt;: All tables have tenant_id → tenants&lt;br/&gt;(tenant_id edges omitted for readability)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Key changes (migrations 002–006)&lt;/b&gt;&lt;br/&gt;• doors + access_point_doors removed&lt;br/&gt;• access_points now links directly to device&lt;br/&gt;• access_group_users M:N junction added&lt;br/&gt;• access_group_access_points has access_time_id override&lt;br/&gt;• dm3_audit.audit_logs hypertable (migration 006)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Junction tables&lt;/b&gt; shown with thin border + gray fill&lt;br/&gt;&lt;b&gt;Dashed edges&lt;/b&gt; = logical reference (no FK)&lt;br/&gt;&lt;b&gt;Solid edges&lt;/b&gt; = hard FK constraint&lt;/span&gt;" style="text;html=1;align=left;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1660" y="915" width="380" height="340" as="geometry"/>
        </mxCell>

        <!-- ═══════════════════ dm3_audit ═══════════════════ -->
        <mxCell id="audit-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FDBA74;dashed=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="580" y="1450" width="530" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="audit-label" value="dm3_audit" style="text;html=1;fontSize=12;fontStyle=1;align=left;fillColor=none;strokeColor=none;fontColor=#F59E0B;" vertex="1" parent="1">
          <mxGeometry x="595" y="1458" width="150" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="audit_logs" value="&lt;b style='color:#F59E0B'&gt;audit_logs ⏱️&lt;/b&gt;&lt;br/&gt;&lt;i style='font-size:10px;color:#94A3B8'&gt;TimescaleDB hypertable&lt;/i&gt;&lt;hr size='1'/&gt;&lt;div style='text-align:left;font-size:11px;padding:4px'&gt;🔑 (id, time) PK&lt;br/&gt;id : UUID def gen_random_uuid()&lt;br/&gt;time : TIMESTAMPTZ def now()&lt;br/&gt;tenant_id : UUID (nullable)&lt;br/&gt;actor_id : UUID · actor_email : VARCHAR&lt;br/&gt;actor_ip : INET · user_agent : TEXT&lt;br/&gt;service : VARCHAR(50) NOT NULL&lt;br/&gt;action : VARCHAR(100) NOT NULL&lt;br/&gt;entity_type : VARCHAR(50) NOT NULL&lt;br/&gt;entity_id : VARCHAR(255)&lt;br/&gt;entity_name : VARCHAR(255)&lt;br/&gt;status : VARCHAR(20) def 'success'&lt;br/&gt;old_values / new_values : JSONB&lt;br/&gt;metadata : JSONB def '{}'&lt;br/&gt;&lt;br/&gt;&lt;i style='font-size:10px'&gt;Chunk: 7 days · Compress: 30 days · Retain: 2 years&lt;br/&gt;INSERT+SELECT only (no UPDATE/DELETE)&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;verticalAlign=top;spacingTop=0;" vertex="1" parent="1">
          <mxGeometry x="600" y="1490" width="490" height="290" as="geometry"/>
        </mxCell>

        <!-- ═══════════════════ RELATIONSHIPS ═══════════════════ -->

        <!-- AUTH internal -->
        <mxCell id="rel-company-accounts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6B7280;endArrow=ERmany;startArrow=ERone;startSize=12;endSize=12;" edge="1" parent="1" source="tenants" target="accounts">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rel-accounts-refresh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6B7280;endArrow=ERmany;startArrow=ERone;startSize=12;endSize=12;" edge="1" parent="1" source="accounts" target="refresh_tokens">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- IDENTITY internal -->
        <mxCell id="rel-dept-users" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#8B5CF6;endArrow=ERmany;startArrow=ERone;startSize=12;endSize=12;" edge="1" parent="1" source="departments" target="identity_users">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rel-users-credentials" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#8B5CF6;endArrow=ERmany;startArrow=ERone;startSize=12;endSize=12;" edge="1" parent="1" source="identity_users" target="credentials">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rel-usergroups-members" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#8B5CF6;endArrow=ERmany;startArrow=ERone;startSize=12;endSize=12;" edge="1" parent="1" source="user_groups" target="user_group_members">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rel-users-members" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#8B5CF6;endArrow=ERmany;startArrow=ERone;startSize=12;endSize=12;" edge="1" parent="1" source="identity_users" target="user_group_members">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- DEVICES internal -->
        <mxCell id="rel-devices-provtokens" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#3B82F6;endArrow=ERmany;startArrow=ERone;startSize=12;endSize=12;" edge="1" parent="1" source="devices" target="provisioning_tokens">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ACCESS internal -->
        <mxCell id="rel-accesstimes-slots" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#3B82F6;endArrow=ERmany;startArrow=ERone;startSize=12;endSize=12;" edge="1" parent="1" source="access_times" target="access_time_slots">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rel-zones-accesspoints" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#3B82F6;endArrow=ERmany;startArrow=ERone;startSize=12;endSize=12;" edge="1" parent="1" source="zones" target="access_points">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rel-accesstimes-accesspoints" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#3B82F6;endArrow=ERmany;startArrow=ERone;startSize=12;endSize=12;" edge="1" parent="1" source="access_times" target="access_points">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rel-accessgroups-agap" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#3B82F6;endArrow=ERmany;startArrow=ERone;startSize=12;endSize=12;" edge="1" parent="1" source="access_groups" target="access_group_access_points">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rel-accesspoints-agap" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#3B82F6;endArrow=ERmany;startArrow=ERone;startSize=12;endSize=12;" edge="1" parent="1" source="access_points" target="access_group_access_points">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- access_group_access_points → access_times (schedule override) -->
        <mxCell id="rel-agap-accesstimes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#3B82F6;dashed=1;dashPattern=4 4;endArrow=open;endSize=8;" edge="1" parent="1" source="access_group_access_points" target="access_times">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- access_group_users junction -->
        <mxCell id="rel-accessgroups-agu" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#3B82F6;endArrow=ERmany;startArrow=ERone;startSize=12;endSize=12;" edge="1" parent="1" source="access_groups" target="access_group_users">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- CROSS-SCHEMA: Auth → Identity -->
        <mxCell id="rel-accounts-identityusers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6B7280;strokeWidth=2;endArrow=ERone;startArrow=ERone;startSize=12;endSize=12;" edge="1" parent="1" source="accounts" target="identity_users">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- CROSS-SCHEMA: Access → Identity (via access_group_users M:N) -->
        <mxCell id="rel-agu-identityusers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10B981;strokeWidth=2;endArrow=ERmany;startArrow=ERone;startSize=12;endSize=12;" edge="1" parent="1" source="identity_users" target="access_group_users">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- CROSS-SCHEMA: Devices → Access (device_id FK on access_points) -->
        <mxCell id="rel-devices-accesspoints" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#10B981;strokeWidth=2;endArrow=ERone;startArrow=ERone;startSize=12;endSize=12;" edge="1" parent="1" source="devices" target="access_points">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- LOGICAL refs from access_events (dashed) -->
        <mxCell id="rel-events-accesspoints" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#F59E0B;dashed=1;dashPattern=8 4;endArrow=open;endSize=8;" edge="1" parent="1" source="access_events" target="access_points">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rel-events-identityusers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#F59E0B;dashed=1;dashPattern=8 4;endArrow=open;endSize=8;" edge="1" parent="1" source="access_events" target="identity_users">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Access control flow annotation -->
        <mxCell id="flow-annotation" value="&lt;div style='font-size:11px;color:#6B7280;text-align:center'&gt;&lt;b&gt;Access Control Flow&lt;/b&gt;&lt;br/&gt;identity.users → access_group_users → access_groups → access_group_access_points → access_points → devices&lt;br/&gt;&lt;i&gt;WHO → GROUP → WHERE → DEVICE&lt;/i&gt;&lt;br/&gt;Schedule: COALESCE(agap.access_time_id, ap.access_time_id) → access_time_slots&lt;/div&gt;" style="text;html=1;align=center;fillColor=#F0FDF4;strokeColor=#86EFAC;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="1330" width="580" height="70" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
